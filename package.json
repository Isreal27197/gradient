{
  "name": "gradient-academic-tracker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "npm install && cd client && npm install && npm run build",
    "start": "node server/index.js",
    "build": "cd client && npm run build",
    "dev:server": "node --watch server/index.js",
    "dev:client": "cd client && npm run dev",
    "reset": "node scripts/reset-db.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.5.0",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "pdfkit": "^0.15.1",
    "zod": "^3.23.8"
  },
  "description": "GPA calculator, CGPA tracker and academic intelligence platform for university students.",
  "engines": {
    "node": ">=18"
  }
}